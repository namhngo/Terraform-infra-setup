{
  "title": "Observability Platform — Overview",
  "uid": "obs-platform-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": ["observability", "platform"],
  "panels": [
    {
      "id": 1,
      "title": "Log Volume (Loki)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=~\".+\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Collector Health — Alloy (Prometheus)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=\"alloy\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Span Rate (Tempo → Prometheus span metrics)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(traces_spanmetrics_calls_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Recent Logs",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=~\".+\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
